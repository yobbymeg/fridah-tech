# Fridah Online Net backend configuration
# Copy the values into Render → Environment, or rename to .env for local runs.

PUBLIC_URL=https://fridahyobbytech.onrender.com

# SwiftWallet (https://swiftwallet.co.ke) — STK Push
SWIFTWALLET_API_KEY=paste-your-swiftwallet-key-here
SWIFTWALLET_WEBHOOK_SECRET=paste-your-webhook-secret-here

# Admin panel password (default if unset: Fridah@2026)
ADMIN_PASSWORD=Fridah@2026

# Where data.json lives (attach a Render Disk for full persistence)
DATA_DIR=/tmp/fridah-data

# SwiftWallet base URL override (testing only)
# SW_BASE_URL=https://swiftwallet.co.ke
